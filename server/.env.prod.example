OPENAI_API_KEY=
BRAVE_SEARCH_API_KEY=
ADMIN_TOKEN=
HTTP_ADDR=:8080
# DATABASE_URL set by docker-compose.prod.yml — do not override

# APNs — drop AuthKey_*.p8 into ./secrets/ on the Pi (gitignored).
# Compose mounts ./secrets into /secrets read-only.
APNS_KEY_PATH=/
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.metaprotocol.notify
# false = sandbox (Xcode debug builds). true = api.push.apple.com (TestFlight / App Store).
APNS_PRODUCTION=
